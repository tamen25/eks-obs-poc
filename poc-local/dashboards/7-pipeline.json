{
  "uid": "poc-pipeline",
  "title": "7 · Pipeline health",
  "description": "Is every node shipping logs, and is anything in the pipeline complaining?",
  "tags": [
    "logging-poc"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "logging-poc"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "cluster",
          "stream": "",
          "refId": "cluster"
        },
        "definition": "label_values(cluster)",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "Each node runs one Fluent Bit agent. If a node stops appearing in *Lines per node*, its agent is not shipping. The two log panels show complaints from the agents and from Loki, Tempo, the collector and Grafana."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "Nodes shipping container logs",
      "description": "Nodes that sent container lines in the last 5 minutes. Should equal the node count.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (node) (count_over_time({cluster=\"$cluster\", container=~\".+\"}[5m])))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Nodes shipping journal",
      "description": "Nodes whose kubelet/containerd/kernel logs arrived in the last 5 minutes.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (node) (count_over_time({cluster=\"$cluster\", job=\"node\"}[5m])))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Event collector",
      "description": "Kubernetes events received in the time range (0 means the collector is not shipping).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({cluster=\"$cluster\", job=\"kubernetes-events\"}[$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Agent warnings and errors",
      "description": "Warning and error lines in the Fluent Bit agents' own logs.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({cluster=\"$cluster\", namespace=\"logging\", container=~\"fluent-bit.*\"} |~ `\\[ ?(warn|error)\\]` [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 5,
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Lines per node",
      "description": "Container lines each node's agent shipped, per interval.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (node) (count_over_time({cluster=\"$cluster\", container=~\".+\"}[$__auto]))",
          "legendFormat": "{{node}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Bytes per namespace",
      "description": "Log volume in bytes, per interval.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (namespace) (bytes_over_time({cluster=\"$cluster\", container=~\".+\"}[$__auto]))",
          "legendFormat": "{{namespace}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "Fluent Bit warnings and errors",
      "description": "From the agents and the event collector.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{cluster=\"$cluster\", namespace=\"logging\", container=~\"fluent-bit.*\"} |~ `\\[ ?(warn|error)\\]`",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 12
      }
    },
    {
      "type": "logs",
      "title": "Loki, Tempo, collector and Grafana warnings and errors",
      "description": "From the backends in the observability namespace.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{cluster=\"$cluster\", namespace=\"observability\"} |~ `(?i)level=(warn|error)|\"level\":\"(warn|error)\"|\\t(warn|error)\\t`",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 12
      }
    }
  ]
}
