{
  "uid": "poc-logs",
  "title": "2 · Logs explorer",
  "description": "Search any container's logs.",
  "tags": [
    "logging-poc"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "logging-poc"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "cluster",
          "stream": "",
          "refId": "cluster"
        },
        "definition": "label_values(cluster)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "namespace",
          "stream": "{cluster=\"$cluster\", container=~\".+\"}",
          "refId": "namespace"
        },
        "definition": "label_values({cluster=\"$cluster\", container=~\".+\"}, namespace)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "container",
          "stream": "{cluster=\"$cluster\", namespace=~\"$namespace\", container=~\".+\"}",
          "refId": "container"
        },
        "definition": "label_values({cluster=\"$cluster\", namespace=~\"$namespace\", container=~\".+\"}, container)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "stream",
        "label": "Stream",
        "type": "custom",
        "query": "stdout,stderr",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pod",
        "label": "Pod contains",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "search",
        "label": "Text (regex)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "Pick a namespace and container at the top, or type part of a pod name or any text (a regular expression, case-insensitive). Click a line for its labels: pod, node, stream. Lines are exactly as the container wrote them."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "timeseries",
      "title": "Matching lines per container",
      "description": "Lines matching the filters above, per container.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (namespace, container) (count_over_time({cluster=\"$cluster\", namespace=~\"$namespace\", container=~\"$container\"} | stream=~\"$stream\" | pod=~\".*$pod.*\" |~ \"(?i)$search\" [$__auto]))",
          "legendFormat": "{{namespace}} / {{container}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 16,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Matching lines",
      "description": "Lines matching the filters in the time range.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({cluster=\"$cluster\", namespace=~\"$namespace\", container=~\"$container\"} | stream=~\"$stream\" | pod=~\".*$pod.*\" |~ \"(?i)$search\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 3,
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 4,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "of which stderr",
      "description": "Matching lines the container wrote to stderr.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({cluster=\"$cluster\", namespace=~\"$namespace\", container=~\"$container\"} | stream=~\"$stream\" | pod=~\".*$pod.*\" |~ \"(?i)$search\" | stream=\"stderr\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 4,
      "gridPos": {
        "x": 20,
        "y": 3,
        "w": 4,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "Log lines",
      "description": "Newest first. Up to 1,000 lines; narrow the filters or time range for more.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{cluster=\"$cluster\", namespace=~\"$namespace\", container=~\"$container\"} | stream=~\"$stream\" | pod=~\".*$pod.*\" |~ \"(?i)$search\"",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 18
      }
    }
  ]
}
