          "expr": "sum(count_over_time({cluster=\"$cluster\", job=\"node\", unit=\"kubelet.service\"} | node=~\".*$node.*\" |~ `(?i)failed to pull|ErrImagePull|ImagePullBackOff` [$__range]))",
