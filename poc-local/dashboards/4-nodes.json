      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (unit) (count_over_time({cluster=\"$cluster\", job=\"node\", unit=~\"$unit\"} | node=~\".*$node.*\" |~ `^E[0-9]{4} |level=error|(?i)killed process|oom-kill` [$__auto]))",
          "legendFormat": "{{unit}}",
          "queryType": "range"
