    {
      "type": "logs",
      "title": "Errors and warnings",
      "description": "kubelet E (error) and W (warning) lines, containerd level=error or warning, and kernel messages at priority warning or worse.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{cluster=\"$cluster\", job=\"node\", unit=\"kubelet.service\"} | node=~\".*$node.*\" |~ `^[EW][0-9]{4}`",
          "legendFormat": "",
          "queryType": "range"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{cluster=\"$cluster\", job=\"node\", unit=\"containerd.service\"} | node=~\".*$node.*\" |~ \"level=(error|warning)\"",
          "legendFormat": "",
          "queryType": "range"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{cluster=\"$cluster\", job=\"node\", unit=\"kernel\"} | node=~\".*$node.*\" | priority=~\"[0-4]\"",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "id": 10,
      "gridPos": {
        "x": 0,
