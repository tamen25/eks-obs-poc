    {
      "type": "stat",
      "title": "Probe failures",
      "description": "Unhealthy events: a liveness, readiness or startup probe failed. From events, because the kubelet logs probe failures only at higher verbosity.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({cluster=\"$cluster\", job=\"kubernetes-events\", reason=\"Unhealthy\"}[$__range]))",
          "legendFormat": "",
