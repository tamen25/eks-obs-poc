    },
    {
      "type": "timeseries",
      "title": "Journal lines per unit and node",
      "description": "How much each node service logs.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (unit, node) (count_over_time({cluster=\"$cluster\", job=\"node\", unit=~\"$unit\"} | node=~\".*$node.*\" |~ \"(?i)$search\" [$__auto]))",
          "legendFormat": "{{unit}} on {{node}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ],
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Errors per unit",
      "description": "kubelet E lines, containerd level=error and kernel OOM kills, per interval.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
