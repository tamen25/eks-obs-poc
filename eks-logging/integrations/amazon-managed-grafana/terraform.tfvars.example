# Copy to terraform.tfvars. grafana_token and loki_password come from the environment
# (TF_VAR_grafana_token, TF_VAR_loki_password), not from this file.

aws_region   = "us-east-1"
workspace_id = "g-0123456789"

# From the eks-logging stack: terraform output amazon_managed_grafana
loki = {
  url  = "https://loki.internal.example.com:8080"
  user = "cloudops-dev-cluster"
  # Only when amazon_managed_grafana.needs_ca_cert is true:
  #   terraform -chdir=../.. output -raw loki_ca_cert_pem
  ca_cert_pem = <<-EOT
    -----BEGIN CERTIFICATE-----
    ...
    -----END CERTIFICATE-----
  EOT
}

dashboards = {
  agents_namespace = "logging" # fluent_bit.namespace in the main stack
}
